---
// Privacy page (both locales). Rendered from the STATIC_PAGES data registry.
import Layout from '../../layouts/Layout.astro';
import StaticPageContent from '../../components/StaticPageContent.astro';
import { createT, buildKeywords } from '../../helpers/i18n-server';
import { STATIC_PAGES } from '../../data/pages';
import { SITE, type Locale } from '../../data/site';

export function getStaticPaths() {
    return SITE.locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = createT(locale);
const page = STATIC_PAGES.find((p) => p.key === 'privacy')!;
const path = `/${locale}/${page.key}/`;
const alternates: Record<Locale, string> = { en: `/en/${page.key}/`, zh: `/zh/${page.key}/` };
---
<Layout
    locale={locale}
    path={path}
    alternates={alternates}
    title={`${t(page.titleKey)} | ${t('site/title')}`}
    description={t(page.descriptionKey)}
    keywords={buildKeywords(t, page.tagsKey)}
    disqusKey={page.key}
>
    <StaticPageContent page={page} t={t} />
</Layout>
