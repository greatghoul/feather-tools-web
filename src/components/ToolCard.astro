---
// Ported from the legacy src/pages/ToolCard.tsx.
import { createT } from '../helpers/i18n-server';
import { TOOL_MAP } from '../data/tools';
import type { Locale } from '../data/site';

const { slug, locale } = Astro.props as { slug: string; locale: Locale };
const t = createT(locale);
const tool = TOOL_MAP[slug];
const name = t(`${slug}/name`);
const note = t(`${slug}/note`);
---
<div class="card card-tool h-100 position-relative overflow-hidden">
    {tool?.logo && (
        <img
            src={`/static/${tool.logo}`}
            alt=""
            aria-hidden="true"
            class="position-absolute top-50 end-0 translate-middle-y"
            style="height: 100%; opacity: 0.12; pointer-events: none;"
        />
    )}
    <div class="card-body py-2 px-3 position-relative z-1">
        <h2 class="h6 card-title mb-1">
            <a href={`/${locale}/${slug}/`} class="stretched-link" title={note}>
                {name}
            </a>
        </h2>
        <p class="card-text card-text-clamp mb-0">{note}</p>
    </div>
</div>
