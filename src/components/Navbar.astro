---
// Ported from the legacy src/pages/Navbar.tsx.
// Tag navigation lives in the home page sidebar; the header stays minimal.
import { createT } from '../helpers/i18n-server';
import { REPO_URL, type Locale } from '../data/site';

const { locale, alternates } = Astro.props as { locale: Locale; alternates: Record<Locale, string> };
const t = createT(locale);
---
<nav class="navbar bg-body-tertiary">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center" href={`/${locale}/`}>
            <img src="/static/favicon-32x32.png" alt="Logo" width={24} height={24} class="me-2" />
            {t('site/title')}
        </a>
        <ul class="navbar-nav flex-row gap-2 mb-0">
            <li class="nav-item">
                <a
                    class="nav-link"
                    href={REPO_URL}
                    target="_blank"
                    rel="noopener"
                >
                    <i class="bi bi-github me-1" />
                    {t('footer/source')}
                </a>
            </li>
            <li class="nav-item dropdown">
                <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="languageDropdown"
                    role="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                >
                    <i class="bi bi-translate" /> {t('site/language')}
                </a>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="languageDropdown">
                    <li><a class="dropdown-item" href={alternates.en}>English</a></li>
                    <li><a class="dropdown-item" href={alternates.zh}>简体中文</a></li>
                </ul>
            </li>
        </ul>
    </div>
</nav>
